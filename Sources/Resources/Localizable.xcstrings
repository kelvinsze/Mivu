    "在竖屏模式下轻微缩小字幕比例，避免横屏视频在小窗口下过度遮挡画面。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkleinert Untertitel im Hochformat leicht, damit sie Videos im Querformat im kleinen Player weniger verdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slightly reduces subtitle size in portrait mode so they cover less of landscape video in the small player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce ligeramente los subtítulos en vertical para que tapen menos el video horizontal en el reproductor pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit légèrement la taille des sous-titres en mode portrait pour moins masquer les vidéos paysage dans le mini-lecteur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz um pouco as legendas no modo retrato para cobrir menos o vídeo em paisagem no player compacto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在竖屏模式下轻微缩小字幕比例，避免横屏视频在小窗口下过度遮挡画面。"
          }
