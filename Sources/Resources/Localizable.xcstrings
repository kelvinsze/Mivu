    "如何在 CarPlay 投屏？": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "如何在 CarPlay 投屏？"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "如何在 CarPlay 投放？"}}, "en": {"stringUnit": {"state": "translated", "value": "How to Cast to CarPlay"}}, "fr": {"stringUnit": {"state": "translated", "value": "Comment diffuser sur CarPlay"}}, "de": {"stringUnit": {"state": "translated", "value": "So überträgst du auf CarPlay"}}, "es": {"stringUnit": {"state": "translated", "value": "Cómo transmitir a CarPlay"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Como transmitir para o CarPlay"}}}},
    "支持投屏的视频 App": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "支持投屏的视频 App"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "支援投放的影片 App"}}, "en": {"stringUnit": {"state": "translated", "value": "Apps That Support Casting"}}, "fr": {"stringUnit": {"state": "translated", "value": "Apps compatibles avec la diffusion"}}, "de": {"stringUnit": {"state": "translated", "value": "Apps mit Übertragungsfunktion"}}, "es": {"stringUnit": {"state": "translated", "value": "Apps compatibles con la transmisión"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Apps compatíveis com transmissão"}}}},
    "请在 App 内打开分享或投屏菜单，并选择 Mivu 作为播放设备。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请在 App 内打开分享或投屏菜单，并选择 Mivu 作为播放设备。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請在 App 中開啟分享或投放選單，並選擇 Mivu 作為播放裝置。"}}, "en": {"stringUnit": {"state": "translated", "value": "Open the Share or Cast menu in the app and choose Mivu as the playback device."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez le menu Partager ou Diffuser de l’app et choisissez Mivu comme appareil de lecture."}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne in der App das Teilen- oder Übertragungsmenü und wähle Mivu als Wiedergabegerät."}}, "es": {"stringUnit": {"state": "translated", "value": "Abre el menú Compartir o Transmitir de la app y elige Mivu como dispositivo de reproducción."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Abra o menu Compartilhar ou Transmitir no app e escolha o Mivu como dispositivo de reprodução."}}}},
    "在视频 App 中打开分享或投屏菜单": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在视频 App 中打开分享或投屏菜单"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在影片 App 中開啟分享或投放選單"}}, "en": {"stringUnit": {"state": "translated", "value": "Open the Share or Cast Menu in the Video App"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrir le menu Partager ou Diffuser dans l’app vidéo"}}, "de": {"stringUnit": {"state": "translated", "value": "Teilen- oder Übertragungsmenü in der Video-App öffnen"}}, "es": {"stringUnit": {"state": "translated", "value": "Abrir el menú Compartir o Transmitir en la app de video"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Abrir o menu Compartilhar ou Transmitir no app de vídeo"}}}},
    "选择 Mivu 作为播放设备": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择 Mivu 作为播放设备"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇 Mivu 作為播放裝置"}}, "en": {"stringUnit": {"state": "translated", "value": "Choose Mivu as the Playback Device"}}, "fr": {"stringUnit": {"state": "translated", "value": "Choisir Mivu comme appareil de lecture"}}, "de": {"stringUnit": {"state": "translated", "value": "Mivu als Wiedergabegerät auswählen"}}, "es": {"stringUnit": {"state": "translated", "value": "Elegir Mivu como dispositivo de reproducción"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolher o Mivu como dispositivo de reprodução"}}}},
    "从其他 App 投屏": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "从其他 App 投屏"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "從其他 App 投放"}}, "en": {"stringUnit": {"state": "translated", "value": "Cast from Another App"}}, "fr": {"stringUnit": {"state": "translated", "value": "Diffuser depuis une autre app"}}, "de": {"stringUnit": {"state": "translated", "value": "Aus einer anderen App übertragen"}}, "es": {"stringUnit": {"state": "translated", "value": "Transmitir desde otra app"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Transmitir de outro app"}}}},
    "Mivu 会在 CarPlay 连接后自动作为局域网投屏设备出现。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Mivu 会在 CarPlay 连接后自动作为局域网投屏设备出现。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 CarPlay 後，Mivu 會自動顯示為區域網路投放裝置。"}}, "en": {"stringUnit": {"state": "translated", "value": "When CarPlay connects, Mivu automatically appears as a casting device on your local network."}}, "fr": {"stringUnit": {"state": "translated", "value": "Lorsque CarPlay se connecte, Mivu apparaît automatiquement comme appareil de diffusion sur votre réseau local."}}, "de": {"stringUnit": {"state": "translated", "value": "Sobald CarPlay verbunden ist, erscheint Mivu automatisch als Übertragungsgerät im lokalen Netzwerk."}}, "es": {"stringUnit": {"state": "translated", "value": "Al conectarse CarPlay, Mivu aparece automáticamente como dispositivo de transmisión en la red local."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando o CarPlay se conecta, o Mivu aparece automaticamente como dispositivo de transmissão na rede local."}}}},
    "投送接收端监控": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "投送接收端监控"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "投放接收端監控"}}, "en": {"stringUnit": {"state": "translated", "value": "Casting Receiver Monitor"}}, "fr": {"stringUnit": {"state": "translated", "value": "Moniteur du récepteur de diffusion"}}, "de": {"stringUnit": {"state": "translated", "value": "Übertragungsempfänger-Monitor"}}, "es": {"stringUnit": {"state": "translated", "value": "Monitor del receptor de transmisión"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Monitor do receptor de transmissão"}}}},
    "输入 HTTP / HTTPS 直链或 HLS (.m3u8) 进行临时测试：": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 HTTP / HTTPS 直链或 HLS (.m3u8) 进行临时测试："}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入 HTTP / HTTPS 直連網址或 HLS (.m3u8) 進行測試："}}, "en": {"stringUnit": {"state": "translated", "value": "Enter a direct HTTP/HTTPS URL or HLS (.m3u8) stream to test:"}}, "fr": {"stringUnit": {"state": "translated", "value": "Saisissez une URL directe HTTP/HTTPS ou un flux HLS (.m3u8) à tester :"}}, "de": {"stringUnit": {"state": "translated", "value": "HTTP/HTTPS-Direktlink oder HLS-Stream (.m3u8) zum Testen eingeben:"}}, "es": {"stringUnit": {"state": "translated", "value": "Introduce una URL directa HTTP/HTTPS o un flujo HLS (.m3u8) para probar:"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Digite um link direto HTTP/HTTPS ou fluxo HLS (.m3u8) para testar:"}}}},
