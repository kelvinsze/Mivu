    "包含 Apple 官方 HLS 多码率流、MP4 高清测试视频，用于验证播放引擎渲染与 CarPlay 投送稳定性。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält Apples offiziellen HLS-Teststream mit mehreren Bitraten und ein HD-MP4-Testvideo zur Prüfung von Wiedergabe und CarPlay-Stabilität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes Apple's official HLS multibitrate stream and an HD MP4 test video to check playback rendering and CarPlay casting stability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye el flujo HLS multibitrável oficial de Apple y un video MP4 HD para comprobar la reproducción y la estabilidad de CarPlay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut le flux HLS multidébit officiel d’Apple et une vidéo MP4 HD pour vérifier le rendu et la stabilité de CarPlay."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui o fluxo HLS multibitrate oficial da Apple e um vídeo MP4 HD para verificar a reprodução e a estabilidade do CarPlay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 Apple 官方 HLS 多码率流、MP4 高清测试视频，用于验证播放引擎渲染与 CarPlay 投送稳定性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 Apple 官方 HLS 多位元率串流與 MP4 高畫質測試影片，用來驗證播放引擎與 CarPlay 投放穩定性。"
          }
        }
      }
    },
    "包含 DLNA 服务监控、Apple HLS / MP4 测试流、自定义 URL 播放器及系统网络诊断。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält DLNA-Überwachung, Apple-HLS/MP4-Teststreams, einen eigenen URL-Player und Netzwerkdiagnosen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes DLNA service monitoring, Apple HLS/MP4 test streams, a custom URL player, and system network diagnostics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye supervisión DLNA, flujos de prueba Apple HLS/MP4, un reproductor URL y diagnósticos de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprend la surveillance DLNA, des flux de test Apple HLS/MP4, un lecteur URL personnalisé et le diagnostic réseau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui monitoramento DLNA, streams de teste Apple HLS/MP4, player de URL e diagnóstico de rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 DLNA 服务监控、Apple HLS / MP4 测试流、自定义 URL 播放器及系统网络诊断。"
          }
        },
        "zh-Hant" : {
