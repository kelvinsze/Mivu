        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el dispositivo de carga a la misma red Wi-Fi que este iPhone. Mantén la app abierta para recibir archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez l’appareil d’envoi au même réseau Wi-Fi que cet iPhone. Gardez l’app ouverte pour recevoir les fichiers."
