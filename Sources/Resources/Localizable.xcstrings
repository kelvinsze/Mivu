            "value" : "Verbinde das sendende Gerät mit demselben WLAN wie dieses iPhone. Lass die App geöffnet, um Uploads zu empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect the uploading device to the same Wi-Fi network as this iPhone. Keep the app open to receive uploads."
