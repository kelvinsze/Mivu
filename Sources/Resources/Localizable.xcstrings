    "正在获取评分": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在获取评分"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在取得評分"}}, "en": {"stringUnit": {"state": "translated", "value": "Loading Ratings"}}, "fr": {"stringUnit": {"state": "translated", "value": "Chargement des notes"}}, "de": {"stringUnit": {"state": "translated", "value": "Bewertungen werden geladen"}}, "es": {"stringUnit": {"state": "translated", "value": "Cargando calificaciones"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Carregando avaliações"}}}},
    "无法解析该媒体流": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法解析该媒体流"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法解析此媒體串流"}}, "en": {"stringUnit": {"state": "translated", "value": "Unable to Parse This Media Stream"}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’analyser ce flux multimédia"}}, "de": {"stringUnit": {"state": "translated", "value": "Medienstream kann nicht verarbeitet werden"}}, "es": {"stringUnit": {"state": "translated", "value": "No se puede analizar este flujo multimedia"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível analisar este fluxo de mídia"}}}},
    "无法解析该媒体，请检查服务器连接": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法解析该媒体，请检查服务器连接"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法解析此媒體，請檢查伺服器連線"}}, "en": {"stringUnit": {"state": "translated", "value": "Unable to Load Media. Check the Server Connection."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de charger le média. Vérifiez la connexion au serveur."}}, "de": {"stringUnit": {"state": "translated", "value": "Medien konnten nicht geladen werden. Serververbindung prüfen."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo cargar el contenido. Comprueba la conexión con el servidor."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível carregar a mídia. Verifique a conexão com o servidor."}}}},
    "无法解析或播放所选视频流": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法解析或播放所选视频流"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法解析或播放所選影片串流"}}, "en": {"stringUnit": {"state": "translated", "value": "Unable to Parse or Play the Selected Video Stream"}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’analyser ou de lire le flux vidéo sélectionné"}}, "de": {"stringUnit": {"state": "translated", "value": "Der ausgewählte Videostream kann nicht verarbeitet oder abgespielt werden"}}, "es": {"stringUnit": {"state": "translated", "value": "No se puede analizar ni reproducir el flujo de video seleccionado"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível analisar ou reproduzir o fluxo de vídeo selecionado"}}}},
    "Open this link on any phone, tablet, or Mac on the same Wi-Fi to push video URLs or control CarPlay:": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在连接同一 Wi-Fi 的手机、平板或 Mac 上打开此链接，即可推送视频 URL 或控制 CarPlay："}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在連接同一 Wi-Fi 的手機、平板或 Mac 上開啟此連結，即可推送影片 URL 或控制 CarPlay："}}, "en": {"stringUnit": {"state": "translated", "value": "Open this link on any phone, tablet, or Mac on the same Wi-Fi to push video URLs or control CarPlay:"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez ce lien sur un téléphone, une tablette ou un Mac connecté au même Wi-Fi pour envoyer des URL vidéo ou contrôler CarPlay :"}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne diesen Link auf einem Gerät im selben WLAN, um Video-URLs zu senden oder CarPlay zu steuern:"}}, "es": {"stringUnit": {"state": "translated", "value": "Abre este enlace en un teléfono, tableta o Mac conectado a la misma red Wi-Fi para enviar URL de video o controlar CarPlay:"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Abra este link em um celular, tablet ou Mac na mesma rede Wi-Fi para enviar URLs de vídeo ou controlar o CarPlay:"}}}},
