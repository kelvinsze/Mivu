    "车辆行驶中，已切换为仅音频播放": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "车辆行驶中，已切换为仅音频播放"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "車輛行駛中，已切換為僅播放音訊"}}, "en": {"stringUnit": {"state": "translated", "value": "Audio-only playback while the vehicle is moving."}}, "fr": {"stringUnit": {"state": "translated", "value": "Lecture audio uniquement lorsque le véhicule roule."}}, "de": {"stringUnit": {"state": "translated", "value": "Während der Fahrt wird nur Audio wiedergegeben."}}, "es": {"stringUnit": {"state": "translated", "value": "Solo se reproduce audio mientras el vehículo está en movimiento."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "A reprodução fica somente em áudio enquanto o veículo está em movimento."}}}},
