    "国内主流云端分发的多媒体测试素材，包含生动的高对比度动态场景，适合用于验证屏幕色彩与渲染帧率表现。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastreiches Videobeispiel zum Prüfen von Farben und Bildrate."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A high-contrast video sample for checking display color and rendering frame rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra de alto contraste para comprobar el color y la frecuencia de imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrait vidéo à fort contraste pour vérifier les couleurs et la fréquence d’images."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amostra de alto contraste para conferir cores e taxa de quadros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于测试显示效果的多媒体片段，包含高对比度动态画面，可检验色彩与帧率表现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於測試顯示效果的多媒體片段，包含高對比度動態畫面，可檢驗色彩與影格率表現。"
          }
        }
      }
    },
    "国内主流高速云 CDN 节点加速的 MP4 H.264 基准测试视频，极速加载，适合测试国内弱网以及低延迟流媒体加载。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP4-H.264-Testvideo über ein schnelles CDN zum Testen von Ladezeit, schwachen Netzen und niedriger Latenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP4 H.264 test video delivered by a fast CDN, useful for testing loading, weak networks, and low-latency playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo de prueba MP4 H.264 desde una CDN rápida para probar carga, redes débiles y baja latencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo de test MP4 H.264 via CDN rapide, utile pour tester le chargement, les réseaux faibles et la faible latence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo de teste MP4 H.264 via CDN rápida para testar carregamento, redes instáveis e baixa latência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由高速 CDN 提供的 MP4 H.264 测试视频，适合测试加载速度、弱网与低延迟播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
