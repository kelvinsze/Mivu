    "视频仅显示在车机屏幕，手机作为遥控器使用" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video wird nur auf dem Fahrzeugdisplay angezeigt; das iPhone dient als Fernbedienung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video appears only on the car display; use your phone as the remote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El video solo aparece en la pantalla del coche; usa el teléfono como control remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo s’affiche uniquement sur l’écran de la voiture ; utilisez le téléphone comme télécommande."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo aparece apenas na tela do carro; use o celular como controle remoto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频仅显示在车机屏幕，手机作为遥控器使用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片僅顯示於車載螢幕，手機可作為遙控器使用"
          }
        }
      }
    },
    "视频将在车机屏幕播放，并可通过 iPhone 控制。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video läuft auf dem Fahrzeugdisplay und lässt sich mit dem iPhone steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video plays on the car display and can be controlled with your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El video se reproduce en la pantalla del coche y se controla con el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo est lue sur l’écran de la voiture et se contrôle depuis l’iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo é reproduzido na tela do carro e pode ser controlado pelo iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频将在车机屏幕播放，并可通过 iPhone 控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片會在車機螢幕播放，並可透過 iPhone 操控。"
