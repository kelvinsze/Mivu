{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "当前格式无法解码，正在尝试备用流：%@": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "当前格式无法解码，正在尝试备用流：%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目前格式無法解碼，正在嘗試備用串流：%@"}}, "en": {"stringUnit": {"state": "translated", "value": "This format could not be decoded. Trying an alternate stream: %@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de décoder ce format. Essai d’un autre flux : %@"}}, "de": {"stringUnit": {"state": "translated", "value": "Dieses Format konnte nicht dekodiert werden. Alternativer Stream wird versucht: %@"}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo decodificar este formato. Se probará otro flujo: %@"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível decodificar este formato. Tentando outro stream: %@"}}}},
    "网络连接失败，请检查网络设置 (%@)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "网络连接失败，请检查网络设置 (%@)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "網路連線失敗，請檢查網路設定 (%@)"}}, "en": {"stringUnit": {"state": "translated", "value": "Network connection failed. Check your network settings (%@)."}}, "fr": {"stringUnit": {"state": "translated", "value": "Échec de la connexion réseau. Vérifiez vos réglages réseau (%@)."}}, "de": {"stringUnit": {"state": "translated", "value": "Netzwerkverbindung fehlgeschlagen. Prüfe deine Netzwerkeinstellungen (%@)."}}, "es": {"stringUnit": {"state": "translated", "value": "Error de conexión de red. Comprueba los ajustes de red (%@)."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Falha na conexão de rede. Verifique as configurações de rede (%@)."}}}},
    "媒体服务器鉴权失败，请重新登录 (%@)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "媒体服务器鉴权失败，请重新登录 (%@)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "媒體伺服器驗證失敗，請重新登入 (%@)"}}, "en": {"stringUnit": {"state": "translated", "value": "Media server authentication failed. Sign in again (%@)."}}, "fr": {"stringUnit": {"state": "translated", "value": "Échec de l’authentification au serveur multimédia. Reconnectez-vous (%@)."}}, "de": {"stringUnit": {"state": "translated", "value": "Authentifizierung am Medienserver fehlgeschlagen. Melde dich erneut an (%@)."}}, "es": {"stringUnit": {"state": "translated", "value": "Falló la autenticación del servidor multimedia. Inicia sesión de nuevo (%@)."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Falha na autenticação do servidor de mídia. Entre novamente (%@)."}}}},
    "媒体服务器响应异常 (HTTP %d): %@": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "媒体服务器响应异常 (HTTP %d): %@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "媒體伺服器回應異常 (HTTP %d)：%@"}}, "en": {"stringUnit": {"state": "translated", "value": "Unexpected media server response (HTTP %d): %@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réponse inattendue du serveur multimédia (HTTP %d) : %@"}}, "de": {"stringUnit": {"state": "translated", "value": "Unerwartete Antwort des Medienservers (HTTP %d): %@"}}, "es": {"stringUnit": {"state": "translated", "value": "Respuesta inesperada del servidor multimedia (HTTP %d): %@"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Resposta inesperada do servidor de mídia (HTTP %d): %@"}}}},
    "服务器认证失败，请检查用户名和密码": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "服务器认证失败，请检查用户名和密码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "伺服器驗證失敗，請檢查使用者名稱和密碼"}}, "en": {"stringUnit": {"state": "translated", "value": "Server authentication failed. Check your username and password."}}, "fr": {"stringUnit": {"state": "translated", "value": "Échec de l’authentification. Vérifiez votre nom d’utilisateur et votre mot de passe."}}, "de": {"stringUnit": {"state": "translated", "value": "Serverauthentifizierung fehlgeschlagen. Prüfe Benutzername und Passwort."}}, "es": {"stringUnit": {"state": "translated", "value": "Falló la autenticación. Comprueba el nombre de usuario y la contraseña."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Falha na autenticação. Verifique o nome de usuário e a senha."}}}},
    "未通过身份验证": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "未通过身份验证"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "未通過身分驗證"}}, "en": {"stringUnit": {"state": "translated", "value": "Authentication Required"}}, "fr": {"stringUnit": {"state": "translated", "value": "Authentification requise"}}, "de": {"stringUnit": {"state": "translated", "value": "Authentifizierung erforderlich"}}, "es": {"stringUnit": {"state": "translated", "value": "Se requiere autenticación"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Autenticação necessária"}}}},
    "服务器返回了无效的数据格式": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "服务器返回了无效的数据格式"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "伺服器傳回了無效的資料格式"}}, "en": {"stringUnit": {"state": "translated", "value": "The server returned data in an invalid format."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le serveur a renvoyé des données dans un format invalide."}}, "de": {"stringUnit": {"state": "translated", "value": "Der Server hat Daten in einem ungültigen Format zurückgegeben."}}, "es": {"stringUnit": {"state": "translated", "value": "El servidor devolvió datos con un formato no válido."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O servidor retornou dados em um formato inválido."}}}},
    "服务器地址不合法，请检查输入的 URL 格式": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "服务器地址不合法，请检查输入的 URL 格式"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "伺服器位址無效，請檢查輸入的 URL 格式"}}, "en": {"stringUnit": {"state": "translated", "value": "The server address is invalid. Check the URL format."}}, "fr": {"stringUnit": {"state": "translated", "value": "L’adresse du serveur est invalide. Vérifiez le format de l’URL."}}, "de": {"stringUnit": {"state": "translated", "value": "Die Serveradresse ist ungültig. Prüfe das URL-Format."}}, "es": {"stringUnit": {"state": "translated", "value": "La dirección del servidor no es válida. Comprueba el formato de la URL."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O endereço do servidor é inválido. Verifique o formato da URL."}}}},
