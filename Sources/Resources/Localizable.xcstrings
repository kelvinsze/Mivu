    "飞牛私有云 (fnOS) 推荐使用内置 WebDAV 协议进行高速挂载与流媒体直链播放。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für fnOS empfiehlt sich das integrierte WebDAV-Protokoll für schnelles Einbinden und direktes Streaming."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For fnOS, use the built-in WebDAV protocol for fast mounting and direct streaming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fnOS, usa el protocolo WebDAV integrado para montar rápidamente y reproducir mediante transmisión directa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour fnOS, utilisez le protocole WebDAV intégré pour un montage rapide et la lecture directe en continu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fnOS, use o protocolo WebDAV integrado para montagem rápida e transmissão direta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
