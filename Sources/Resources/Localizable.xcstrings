    "Surface: %@" : {

    },
    "Ton Roosendaal 是荷兰著名软件开发者与电影制片人，Blender 开源 3D 创作套件的首席创作者，Blender 基金会创始人兼主席。他主导了《Elephants Dream》、《大白兔》、《Sintel》等一系列开源电影项目，推动了全球开放电影与开源 CG 技术的蓬勃发展。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal ist ein niederländischer Entwickler und Filmproduzent, Schöpfer von Blender sowie Gründer und Vorsitzender der Blender Foundation. Er leitete mehrere Open-Movie-Projekte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal is a Dutch software developer and film producer, creator of Blender and founder and chair of the Blender Foundation. He led several open movie projects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal es desarrollador y productor neerlandés, creador de Blender y fundador y presidente de Blender Foundation. Lideró varios proyectos de películas abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal est un développeur et producteur néerlandais, créateur de Blender et fondateur-président de la Blender Foundation. Il a dirigé plusieurs projets de films libres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal é desenvolvedor e produtor neerlandês, criador do Blender e fundador e presidente da Blender Foundation. Liderou vários projetos de filmes abertos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal 是荷兰著名软件开发者与电影制片人，Blender 开源 3D 创作套件的首席创作者，Blender 基金会创始人兼主席。他主导了《Elephants Dream》、《大白兔》、《Sintel》等一系列开源电影项目，推动了全球开放电影与开源 CG 技术的蓬勃发展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Roosendaal 是荷蘭知名軟體開發者與電影製片人，也是 Blender 的主要創作者及 Blender 基金會創辦人兼主席。他推動了多部開源電影製作。"
          }
        }
      }
    },
