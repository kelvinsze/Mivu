    "人声增强可动态平衡对白响度。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachverstärkung gleicht die Dialoglautstärke dynamisch aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Boost dynamically balances dialogue volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El realce de voz equilibra dinámicamente el volumen de los diálogos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplification des voix équilibre automatiquement le volume des dialogues."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O realce de voz equilibra dinamicamente o volume dos diálogos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声增强可动态平衡对白响度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人聲增強可動態平衡對白音量。"
          }
        }
      }
    },
    "人声增强可动态平衡对白响度。Debug 构建可临时关闭行驶中视频限制检测，用于验证 CarPlay 降级逻辑。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachverstärkung gleicht Dialoglautstärken dynamisch aus. Debug-Builds können Fahrtbeschränkungen vorübergehend deaktivieren, um das CarPlay-Fallback zu testen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice boost dynamically balances dialogue volume. Debug builds can temporarily disable driving video restriction checks to test CarPlay fallback behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejora de voz equilibra el volumen de los diálogos. Las compilaciones Debug pueden desactivar temporalmente las restricciones de video al conducir para probar la alternativa de CarPlay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplification vocale équilibre le volume des dialogues. Les versions Debug peuvent désactiver temporairement les restrictions vidéo en conduite pour tester le repli CarPlay."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reforço de voz equilibra o volume dos diálogos. Builds Debug podem desativar temporariamente as restrições de vídeo ao dirigir para testar a alternativa do CarPlay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声增强可动态平衡对白响度。Debug 构建可临时关闭行驶中视频限制检测，用于验证 CarPlay 降级逻辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人聲增強可動態平衡對白音量。Debug 版本可暫時關閉行車影片限制偵測，以驗證 CarPlay 降級邏輯。"
          }
        }
      }
    },
    "人声增强运用动态规格化压缩（dynaudnorm），提升低语对白响度并平衡爆炸声。超量增益最高可将音量放大至 200%。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachverstärkung nutzt dynamische Normalisierung (dynaudnorm), um leise Dialoge anzuheben und laute Effekte auszugleichen. Die Zusatzverstärkung erhöht die Lautstärke um bis zu 200 %."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice boost uses dynamic normalization (dynaudnorm) to raise quiet dialogue and balance loud effects. Extra gain can increase volume by up to 200%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejora de voz usa normalización dinámica (dynaudnorm) para realzar diálogos bajos y equilibrar efectos fuertes. La ganancia adicional puede aumentar el volumen hasta un 200 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplification vocale utilise la normalisation dynamique (dynaudnorm) pour renforcer les dialogues faibles et équilibrer les effets forts. Le gain supplémentaire peut augmenter le volume jusqu’à 200 %."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reforço de voz usa normalização dinâmica (dynaudnorm) para realçar diálogos baixos e equilibrar efeitos altos. O ganho extra pode aumentar o volume em até 200%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声增强运用动态规格化压缩（dynaudnorm），提升低语对白响度并平衡爆炸声。超量增益最高可将音量放大至 200%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人聲增強使用動態正規化壓縮（dynaudnorm），提高低聲對白音量並平衡爆炸聲。增益最高可將音量提高至 200%。"
          }
        }
      }
    },
