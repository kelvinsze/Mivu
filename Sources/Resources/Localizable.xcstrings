    "延迟 0.5 秒 (+0.5s)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "延迟 0.5 秒 (+0.5s)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "延遲 0.5 秒 (+0.5s)"}}, "en": {"stringUnit": {"state": "translated", "value": "Delay 0.5s (+0.5s)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Retarder de 0,5 s (+0,5 s)"}}, "de": {"stringUnit": {"state": "translated", "value": "0,5 s verzögern (+0,5 s)"}}, "es": {"stringUnit": {"state": "translated", "value": "Retrasar 0,5 s (+0,5 s)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Atrasar 0,5 s (+0,5 s)"}}}},
    "跳过片尾，播放下一集": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "跳过片尾，播放下一集"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "略過片尾，播放下一集"}}, "en": {"stringUnit": {"state": "translated", "value": "Skip Credits & Play Next"}}, "fr": {"stringUnit": {"state": "translated", "value": "Passer le générique et lire la suite"}}, "de": {"stringUnit": {"state": "translated", "value": "Abspann überspringen & weiter"}}, "es": {"stringUnit": {"state": "translated", "value": "Omitir créditos y reproducir siguiente"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Pular créditos e reproduzir próximo"}}}},
    "极大 (160%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "极大 (160%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "特大 (160%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Largest (160%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Très grand (160 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Sehr groß (160 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Muy grande (160 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Enorme (160%)"}}}},
    "极小 (75%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "极小 (75%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "極小 (75%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Smallest (75%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Très petit (75 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Sehr klein (75 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Muy pequeño (75 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Bem pequeno (75%)"}}}},
    "较大 (120%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "较大 (120%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "較大 (120%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Larger (120%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Grand (120 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Groß (120 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Grande (120 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Maior (120%)"}}}},
    "较小 (85%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "较小 (85%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "較小 (85%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Smaller (85%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Petit (85 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Klein (85 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Pequeño (85 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Menor (85%)"}}}},
    "标准 (100%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "标准 (100%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "標準 (100%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Standard (100%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Standard (100 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Standard (100 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Estándar (100 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Padrão (100%)"}}}},
    "特大 (140%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "特大 (140%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "特大 (140%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Extra Large (140%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Très grand (140 %)"}}, "de": {"stringUnit": {"state": "translated", "value": "Extra groß (140 %)"}}, "es": {"stringUnit": {"state": "translated", "value": "Extra grande (140 %)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Extra grande (140%)"}}}},
    "竖屏适度缩小 (0.85x)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "竖屏适度缩小 (0.85x)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "直向模式適度縮小 (0.85x)"}}, "en": {"stringUnit": {"state": "translated", "value": "Slightly Smaller in Portrait (0.85×)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réduire légèrement en portrait (0,85×)"}}, "de": {"stringUnit": {"state": "translated", "value": "Im Hochformat leicht verkleinern (0,85×)"}}, "es": {"stringUnit": {"state": "translated", "value": "Reducir ligeramente en vertical (0,85×)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Reduzir um pouco no modo retrato (0,85×)"}}}},
    "人声增强可动态平衡对白响度。Debug 构建可临时关闭行驶中视频限制检测，用于验证 CarPlay 降级逻辑。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "人声增强可动态平衡对白响度。Debug 构建可临时关闭行驶中视频限制检测，用于验证 CarPlay 降级逻辑。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "人聲增強可動態平衡對白音量。Debug 版本可暫時關閉行車影片限制偵測，以驗證 CarPlay 降級邏輯。"}}, "en": {"stringUnit": {"state": "translated", "value": "Voice boost dynamically balances dialogue volume. Debug builds can temporarily disable driving video restriction checks to test CarPlay fallback behavior."}}, "fr": {"stringUnit": {"state": "translated", "value": "L’amplification vocale équilibre le volume des dialogues. Les versions Debug peuvent désactiver temporairement les restrictions vidéo en conduite pour tester le repli CarPlay."}}, "de": {"stringUnit": {"state": "translated", "value": "Die Sprachverstärkung gleicht Dialoglautstärken dynamisch aus. Debug-Builds können Fahrtbeschränkungen vorübergehend deaktivieren, um das CarPlay-Fallback zu testen."}}, "es": {"stringUnit": {"state": "translated", "value": "La mejora de voz equilibra el volumen de los diálogos. Las compilaciones Debug pueden desactivar temporalmente las restricciones de video al conducir para probar la alternativa de CarPlay."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O reforço de voz equilibra o volume dos diálogos. Builds Debug podem desativar temporariamente as restrições de vídeo ao dirigir para testar a alternativa do CarPlay."}}}},
    "同一 Wi-Fi 下，在电脑或手机浏览器打开 Mivu 显示的地址即可上传视频；完成后会立即在 App 中播放。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "同一 Wi-Fi 下，在电脑或手机浏览器打开 Mivu 显示的地址即可上传视频；完成后会立即在 App 中播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在同一 Wi-Fi 網路下，用電腦或手機瀏覽器開啟 Mivu 顯示的網址即可上傳影片；上傳完成後會立即在 App 中播放。"}}, "en": {"stringUnit": {"state": "translated", "value": "On the same Wi-Fi network, open the address shown in Mivu in a browser to upload a video. It plays in the app as soon as the upload finishes."}}, "fr": {"stringUnit": {"state": "translated", "value": "Sur le même réseau Wi-Fi, ouvrez l’adresse affichée par Mivu dans un navigateur pour importer une vidéo. Elle sera lue dans l’app dès la fin de l’importation."}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne im selben WLAN die in Mivu angezeigte Adresse im Browser, um ein Video hochzuladen. Nach dem Upload wird es sofort in der App abgespielt."}}, "es": {"stringUnit": {"state": "translated", "value": "En la misma red Wi-Fi, abre en un navegador la dirección que muestra Mivu para subir un video. Se reproducirá en la app al terminar la carga."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Na mesma rede Wi-Fi, abra em um navegador o endereço exibido pelo Mivu para enviar um vídeo. Ele será reproduzido no app assim que o envio terminar."}}}},
    "支持直接输入 IP 地址（如 192.168.1.100）或完整路径（如 smb://192.168.1.100/video）。未指定共享名时将自动列出所有共享文件夹。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "支持直接输入 IP 地址（如 192.168.1.100）或完整路径（如 smb://192.168.1.100/video）。未指定共享名时将自动列出所有共享文件夹。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "可直接輸入 IP 位址 (例如 192.168.1.100) 或完整路徑 (例如 smb://192.168.1.100/video)。未指定共用名稱時，會自動列出所有共用資料夾。"}}, "en": {"stringUnit": {"state": "translated", "value": "Enter an IP address (e.g. 192.168.1.100) or full path (e.g. smb://192.168.1.100/video). If no share is specified, all available shares are listed."}}, "fr": {"stringUnit": {"state": "translated", "value": "Saisissez une adresse IP (ex. 192.168.1.100) ou un chemin complet (ex. smb://192.168.1.100/video). Sans partage précisé, tous les partages seront listés."}}, "de": {"stringUnit": {"state": "translated", "value": "Gib eine IP-Adresse (z. B. 192.168.1.100) oder einen vollständigen Pfad (z. B. smb://192.168.1.100/video) ein. Ohne Freigabe werden alle Freigaben angezeigt."}}, "es": {"stringUnit": {"state": "translated", "value": "Introduce una dirección IP (p. ej., 192.168.1.100) o una ruta completa (p. ej., smb://192.168.1.100/video). Si no indicas un recurso, se mostrarán todos."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Digite um endereço IP (ex.: 192.168.1.100) ou caminho completo (ex.: smb://192.168.1.100/video). Se não especificar um compartilhamento, todos serão listados."}}}},
    "当前主版本": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "当前主版本"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目前主版本"}}, "en": {"stringUnit": {"state": "translated", "value": "Current Version"}}, "fr": {"stringUnit": {"state": "translated", "value": "Version actuelle"}}, "de": {"stringUnit": {"state": "translated", "value": "Aktuelle Version"}}, "es": {"stringUnit": {"state": "translated", "value": "Versión actual"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Versão atual"}}}},
    "连接 CarPlay": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "连接 CarPlay"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 CarPlay"}}, "en": {"stringUnit": {"state": "translated", "value": "Connect CarPlay"}}, "fr": {"stringUnit": {"state": "translated", "value": "Connecter CarPlay"}}, "de": {"stringUnit": {"state": "translated", "value": "CarPlay verbinden"}}, "es": {"stringUnit": {"state": "translated", "value": "Conectar CarPlay"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectar CarPlay"}}}},
    "连接 Emby、Jellyfin、NAS": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "连接 Emby、Jellyfin、NAS"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 Emby、Jellyfin、NAS"}}, "en": {"stringUnit": {"state": "translated", "value": "Connect Emby, Jellyfin, or NAS"}}, "fr": {"stringUnit": {"state": "translated", "value": "Connecter Emby, Jellyfin ou un NAS"}}, "de": {"stringUnit": {"state": "translated", "value": "Emby, Jellyfin oder NAS verbinden"}}, "es": {"stringUnit": {"state": "translated", "value": "Conectar Emby, Jellyfin o NAS"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectar Emby, Jellyfin ou NAS"}}}},
    "A-B 循环：%@ ~ %@": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "A-B 循环：%@ ~ %@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "A-B 循環：%@ ~ %@"}}, "en": {"stringUnit": {"state": "translated", "value": "A-B Loop: %@ ~ %@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Boucle A-B : %@ ~ %@"}}, "de": {"stringUnit": {"state": "translated", "value": "A-B-Schleife: %@ ~ %@"}}, "es": {"stringUnit": {"state": "translated", "value": "Bucle A-B: %@ ~ %@"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Loop A-B: %@ ~ %@"}}}},
    "字幕大小 (%lld%%)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "字幕大小 (%lld%%)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "字幕大小 (%lld%%)"}}, "en": {"stringUnit": {"state": "translated", "value": "Subtitle Size (%lld%%)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Taille des sous-titres (%lld%%)"}}, "de": {"stringUnit": {"state": "translated", "value": "Untertitelgröße (%lld%%)"}}, "es": {"stringUnit": {"state": "translated", "value": "Tamaño de subtítulos (%lld%%)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Tamanho das legendas (%lld%%)"}}}},
    "字幕同步 (%@)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "字幕同步 (%@)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "字幕同步 (%@)"}}, "en": {"stringUnit": {"state": "translated", "value": "Subtitle Sync (%@)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Synchronisation des sous-titres (%@)"}}, "de": {"stringUnit": {"state": "translated", "value": "Untertitelsynchronisierung (%@)"}}, "es": {"stringUnit": {"state": "translated", "value": "Sincronización de subtítulos (%@)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Sincronização das legendas (%@)"}}}},
    "已对齐": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已对齐"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已同步"}}, "en": {"stringUnit": {"state": "translated", "value": "Synced"}}, "fr": {"stringUnit": {"state": "translated", "value": "Synchronisé"}}, "de": {"stringUnit": {"state": "translated", "value": "Synchronisiert"}}, "es": {"stringUnit": {"state": "translated", "value": "Sincronizado"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Sincronizado"}}}},
    "选择播放版本 (%d)": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择播放版本 (%d)"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇播放版本 (%d)"}}, "en": {"stringUnit": {"state": "translated", "value": "Choose Version (%d)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Choisir la version (%d)"}}, "de": {"stringUnit": {"state": "translated", "value": "Version auswählen (%d)"}}, "es": {"stringUnit": {"state": "translated", "value": "Elegir versión (%d)"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolher versão (%d)"}}}},
    "在竖屏模式下轻微缩小字幕比例，避免横屏视频在小窗口下过度遮挡画面。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在竖屏模式下轻微缩小字幕比例，避免横屏视频在小窗口下过度遮挡画面。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "直向模式下會稍微縮小字幕，避免橫向影片在小視窗中遮擋過多畫面。"}}, "en": {"stringUnit": {"state": "translated", "value": "Slightly reduces subtitle size in portrait mode so they cover less of landscape video in the small player."}}, "fr": {"stringUnit": {"state": "translated", "value": "Réduit légèrement la taille des sous-titres en mode portrait pour moins masquer les vidéos paysage dans le mini-lecteur."}}, "de": {"stringUnit": {"state": "translated", "value": "Verkleinert Untertitel im Hochformat leicht, damit sie Videos im Querformat im kleinen Player weniger verdecken."}}, "es": {"stringUnit": {"state": "translated", "value": "Reduce ligeramente los subtítulos en vertical para que tapen menos el video horizontal en el reproductor pequeño."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Reduz um pouco as legendas no modo retrato para cobrir menos o vídeo em paisagem no player compacto."}}}},
    "恢复播放回退帮助您重新衔接前情；片尾临近时右下角会浮现『跳过片尾，播放下一集』快捷浮窗。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复播放回退帮助您重新衔接前情；片尾临近时右下角会浮现『跳过片尾，播放下一集』快捷浮窗。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復播放時回退可幫助接續劇情；片尾將近時，右下角會出現「略過片尾，播放下一集」快捷按鈕。"}}, "en": {"stringUnit": {"state": "translated", "value": "Rewind slightly when resuming to catch up. Near the credits, a Skip Credits and Play Next shortcut appears."}}, "fr": {"stringUnit": {"state": "translated", "value": "Revenez légèrement en arrière à la reprise. À l’approche du générique, un raccourci permet de le passer et de lire l’épisode suivant."}}, "de": {"stringUnit": {"state": "translated", "value": "Springe beim Fortsetzen etwas zurück. Kurz vor dem Abspann erscheint eine Schaltfläche zum Überspringen und Starten der nächsten Folge."}}, "es": {"stringUnit": {"state": "translated", "value": "Retrocede un poco al reanudar. Cerca de los créditos aparecerá un acceso para omitirlos y reproducir el siguiente episodio."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Volte um pouco ao retomar. Perto dos créditos, aparece um atalho para pulá-los e reproduzir o próximo episódio."}}}},
    "设定 A 点与 B 点后，播放器将在区间内自动无限循环，适合反复观摩精彩瞬间或外语精听。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "设定 A 点与 B 点后，播放器将在区间内自动无限循环，适合反复观摩精彩瞬间或外语精听。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "設定 A 點與 B 點後，播放器會在該區間自動循環，適合反覆欣賞片段或練習外語聽力。"}}, "en": {"stringUnit": {"state": "translated", "value": "Set points A and B to loop that segment continuously—ideal for replaying a scene or language practice."}}, "fr": {"stringUnit": {"state": "translated", "value": "Définissez les points A et B pour lire la séquence en boucle, idéal pour revoir une scène ou pratiquer une langue."}}, "de": {"stringUnit": {"state": "translated", "value": "Lege Punkt A und B fest, um den Abschnitt endlos zu wiederholen – ideal für Szenen oder Sprachübungen."}}, "es": {"stringUnit": {"state": "translated", "value": "Define los puntos A y B para repetir el fragmento en bucle, ideal para volver a ver una escena o practicar idiomas."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Defina os pontos A e B para repetir o trecho em loop, ideal para rever uma cena ou praticar idiomas."}}}},
    "该分类媒体库下未检索到可播放的影视文件。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "该分类媒体库下未检索到可播放的影视文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此分類媒體庫中找不到可播放的影片。"}}, "en": {"stringUnit": {"state": "translated", "value": "No playable videos were found in this library."}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune vidéo lisible n’a été trouvée dans cette bibliothèque."}}, "de": {"stringUnit": {"state": "translated", "value": "In dieser Mediathek wurden keine abspielbaren Videos gefunden."}}, "es": {"stringUnit": {"state": "translated", "value": "No se encontraron videos reproducibles en esta biblioteca."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Nenhum vídeo reproduzível foi encontrado nesta biblioteca."}}}},
    "该视频暂无字幕轨道。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "该视频暂无字幕轨道。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此影片目前沒有字幕軌。"}}, "en": {"stringUnit": {"state": "translated", "value": "This video has no subtitle tracks."}}, "fr": {"stringUnit": {"state": "translated", "value": "Cette vidéo ne contient aucune piste de sous-titres."}}, "de": {"stringUnit": {"state": "translated", "value": "Dieses Video enthält keine Untertitelspuren."}}, "es": {"stringUnit": {"state": "translated", "value": "Este video no tiene pistas de subtítulos."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Este vídeo não tem faixas de legenda."}}}},
