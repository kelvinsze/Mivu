    "视频将在车机屏幕播放，并可通过 iPhone 控制。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "视频将在车机屏幕播放，并可通过 iPhone 控制。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "影片會在車機螢幕播放，並可透過 iPhone 操控。"}}, "en": {"stringUnit": {"state": "translated", "value": "Video plays on the car display and can be controlled with your iPhone."}}, "fr": {"stringUnit": {"state": "translated", "value": "La vidéo est lue sur l’écran de la voiture et se contrôle depuis l’iPhone."}}, "de": {"stringUnit": {"state": "translated", "value": "Das Video läuft auf dem Fahrzeugdisplay und lässt sich mit dem iPhone steuern."}}, "es": {"stringUnit": {"state": "translated", "value": "El video se reproduce en la pantalla del coche y se controla con el iPhone."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O vídeo é reproduzido na tela do carro e pode ser controlado pelo iPhone."}}}},
    "在 CarPlay 播放": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在 CarPlay 播放"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在 CarPlay 播放"}}, "en": {"stringUnit": {"state": "translated", "value": "Play on CarPlay"}}, "fr": {"stringUnit": {"state": "translated", "value": "Lire sur CarPlay"}}, "de": {"stringUnit": {"state": "translated", "value": "Auf CarPlay abspielen"}}, "es": {"stringUnit": {"state": "translated", "value": "Reproducir en CarPlay"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Reproduzir no CarPlay"}}}},
