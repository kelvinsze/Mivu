{
  "name": "ratings-api",
  "version": "1.0.0",
  "description": "Unified media ratings API for Mivu running on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "ratings",
    "mdblist",
    "douban",
    "mivu"
  ],
  "author": "Mivu Team",
  "license": "MIT",
  "dependencies": {
    "@peculiar/asn1-ecc": "^2.9.4",
    "@peculiar/asn1-schema": "^2.9.4",
    "@peculiar/x509": "^2.1.0",
    "cbor-x": "^1.6.6",
    "hono": "^4.7.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.111.0"
  }
}
